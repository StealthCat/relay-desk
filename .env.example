# Copy this file to .env beside compose.yaml for local deployment settings.
# Bind to 127.0.0.1 for local access, or use an IP assigned to the Docker host.
RELAY_DESK_BIND_IP=127.0.0.1
RELAY_DESK_PORT=8080
# Host names (not IPs) used to open the dashboard, comma-separated. IPs and localhost always work.
# RELAY_DESK_HOSTNAMES=relay.home.arpa

# Optional API tokens for nodes using apiKeyEnv in config/repeaters.json.
# HOME_REPEATER_KEY=
